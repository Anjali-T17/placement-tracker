# Example Terraform variables file for Placement Tracker Infrastructure
# Copy this file to "terraform.tfvars" if you wish to customize variables:
#   cp terraform.tfvars.example terraform.tfvars

aws_region     = "ap-southeast-2"
vpc_id         = "vpc-005bb88d77ebfd4f7"
subnet_id      = "subnet-0d4fa31cc4cfac75f"
instance_type  = "t3.small"
project_name   = "placement-tracker"
environment    = "dev"

# Optional: Set your specific public IP for SSH access (e.g., "203.0.113.25/32").
# Leave empty ("") to keep port 22 closed and manage the instance via AWS Systems Manager.
admin_ssh_cidr = ""
