# Terraform AWS Provider Configuration for College Placement Tracker

terraform {
  required_version = ">= 1.5.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# The AWS provider uses the standard AWS CLI credential chain (e.g., ~/.aws/credentials, environment variables).
# Access keys and secret keys are NEVER hardcoded.
provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}
