# Copy this file to ".env" and edit it:   cp .env.example .env
# The real ".env" file is private and must NEVER be pushed to GitHub.

FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5001

# Which frontend addresses may call this API (* allows local frontend dev servers)
CORS_ORIGINS=*

# Database settings
DB_TYPE=sqlite
DATABASE_PATH=placement.db

# Optional MySQL configuration (uncomment if using MySQL)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=password
# DB_NAME=placement
